{
  "name": "khardal-perfumeria",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "format": "prettier --write src tests scripts/woocommerce/*.mjs scripts/woocommerce/*.yml *.mjs playwright.config.ts package.json tsconfig.json .prettierrc.json .github render.yaml docker-compose.yml",
    "format:check": "prettier --check src tests scripts/woocommerce/*.mjs scripts/woocommerce/*.yml *.mjs playwright.config.ts package.json tsconfig.json .prettierrc.json .github render.yaml docker-compose.yml",
    "lint": "eslint src tests scripts/woocommerce/*.mjs *.mjs playwright.config.ts --max-warnings 0",
    "verify": "pnpm format:check && pnpm lint && pnpm test:config && pnpm test:commerce && pnpm test:woocommerce && pnpm check && pnpm build && pnpm test:runtime",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node --env-file-if-exists=.env dist/server/entry.mjs",
    "test:config": "node --experimental-strip-types --test tests/commerce-config.test.ts tests/storefront-origin.test.mjs tests/seo.test.ts",
    "assets:social": "node social-preview.mjs",
    "test:seo:host": "node --test tests/seo-host.test.mjs",
    "test:commerce": "node --experimental-strip-types --test tests/commerce.test.ts tests/cart.test.ts tests/cart-validation.test.ts tests/whatsapp.test.ts",
    "test:runtime": "node --test tests/runtime.test.mjs",
    "test:ui": "playwright test",
    "astro": "astro",
    "woo:init": "node scripts/woocommerce/init-env.mjs",
    "woo:up": "docker compose --env-file .env.woocommerce up -d --wait db wordpress",
    "woo:setup": "docker compose --env-file .env.woocommerce run --rm setup",
    "woo:cli": "docker compose --env-file .env.woocommerce run --rm --entrypoint wp setup",
    "woo:check": "node --env-file=.env.woocommerce scripts/woocommerce/check.mjs",
    "woo:use": "node --env-file=.env.woocommerce scripts/woocommerce/use-local.mjs",
    "woo:backup": "bash scripts/woocommerce/backup.sh",
    "woo:backup:check": "node scripts/woocommerce/backup-verify.mjs",
    "test:woocommerce": "node --experimental-strip-types --test tests/woocommerce.test.ts tests/woocommerce-validation.test.ts",
    "test:woocommerce:local": "node --env-file=.env.woocommerce --experimental-strip-types --test tests/woocommerce.local.test.ts",
    "test:woocommerce:storefront": "node --env-file=.env.woocommerce --test tests/woocommerce-storefront.test.mjs",
    "test:woocommerce:journey": "node --env-file=.env.woocommerce --test tests/woocommerce-journey.test.mjs",
    "test:woocommerce:recovery": "node --env-file=.env.woocommerce --test tests/woocommerce-recovery.test.mjs",
    "test:woocommerce:accessibility": "node --env-file=.env.woocommerce --test tests/woocommerce-accessibility.test.mjs",
    "woo:seed": "node --env-file=.env.woocommerce --experimental-strip-types scripts/woocommerce/seed.mjs seed",
    "woo:seed:check": "node --env-file=.env.woocommerce --experimental-strip-types scripts/woocommerce/seed.mjs check",
    "woo:seed:repeat-check": "node --env-file=.env.woocommerce --experimental-strip-types scripts/woocommerce/seed.mjs repeat-check",
    "woo:stop": "docker compose --env-file .env.woocommerce stop",
    "woo:down": "docker compose --env-file .env.woocommerce down"
  },
  "dependencies": {
    "@astrojs/node": "11.1.9",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/metrophobic": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
