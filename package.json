{
  "name": "khardal-perfumeria",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "format": "prettier --write src tests *.mjs playwright.config.ts package.json tsconfig.json .prettierrc.json .github render.yaml",
    "format:check": "prettier --check src tests *.mjs playwright.config.ts package.json tsconfig.json .prettierrc.json .github render.yaml",
    "lint": "eslint src tests *.mjs playwright.config.ts --max-warnings 0",
    "verify": "pnpm format:check && pnpm lint && pnpm test:config && pnpm test:commerce && pnpm check && pnpm build && pnpm test:runtime",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node --env-file-if-exists=.env dist/server/entry.mjs",
    "test:config": "node --experimental-strip-types --test tests/commerce-config.test.ts",
    "test:commerce": "node --experimental-strip-types --test tests/commerce.test.ts tests/cart.test.ts",
    "test:runtime": "node --test tests/runtime.test.mjs",
    "test:ui": "playwright test",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/node": "11.1.9",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/metrophobic": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
