# Copy to .env for local development. No credentials are needed for mock mode.
# These values are server-only; never rename credentials with a PUBLIC_ prefix.
COMMERCE_PROVIDER=mock

# Build-time setting: rebuild when switching deployment environments.
# Development and preview pages include noindex metadata.
DEPLOYMENT_ENV=development

# Hosted build process setting (not a backend URL or a secret):
# STOREFRONT_ORIGIN=https://your-storefront.example pnpm build
# Loopback hosts work by default. Render builds can use RENDER_EXTERNAL_URL.
# Set this in the build environment; this config setting is not loaded from .env.

# Required only when COMMERCE_PROVIDER=woocommerce.
# Store root URL; HTTP is allowed only for loopback Docker development.
WOOCOMMERCE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# Required only when COMMERCE_PROVIDER=shopify.
# Bare permanent shop hostname, for example your-store.myshopify.com.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
