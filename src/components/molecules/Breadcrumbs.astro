---
import { siteOrigin, jsonLd } from '../../lib/seo';
interface Props {
  items: { label: string; href?: string }[];
}
const { items } = Astro.props;
const site = siteOrigin(import.meta.env.SITE);
const schema = site
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: items.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.label,
        item: new URL(item.href ?? Astro.url.pathname, site).href,
      })),
    }
  : null;
---

<nav aria-label="Ruta de navegación">
  <ol class="flex flex-wrap gap-x-space-sm gap-y-space-xs text-sm text-on-surface-variant">
    {items.map((item, index) => (
      <li class="flex items-center gap-space-sm">
        {index > 0 && <span aria-hidden="true">/</span>}
        {index === items.length - 1 ? (
          <span aria-current="page">{item.label}</span>
        ) : item.href ? (
          <a
            href={item.href}
            class="inline-flex min-h-11 items-center underline"
          >
            {item.label}
          </a>
        ) : (
          <span>{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
{schema && <script type="application/ld+json" set:html={jsonLd(schema)} />}
