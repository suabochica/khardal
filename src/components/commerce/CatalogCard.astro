---
import ProductCard from '../molecules/ProductCard.astro';
import type { Product } from '../../lib/commerce/models';
import { lowestPrice } from '../../lib/commerce/catalog';
interface Props {
  product: Product;
  linked?: boolean;
}
const { product, linked = true } = Astro.props;
const available = product.variants.some((v) => v.availability === 'available');
const unknown = product.variants.some((v) => v.availability === 'unknown');
const price = lowestPrice(product);
---

<ProductCard
  name={product.name}
  href={linked ? `/perfumes/${product.slug}` : undefined}
  amountCop={price}
  from={product.variants.length > 1}
  notes={[product.category, product.family].filter(Boolean).join(' · ')}
  image={product.images[0]}
  available={available}
  unavailableLabel={
    price === null
      ? 'Precio por confirmar'
      : unknown
        ? 'Disponibilidad por confirmar'
        : 'Agotado'
  }
/>
