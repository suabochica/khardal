---
import type { CatalogImage } from '../../lib/commerce/models';
import CatalogImageElement from '../atoms/CatalogImage.astro';
import { imageAttributes } from '../../lib/images';
interface Props {
  images: CatalogImage[];
}
const { images } = Astro.props;
const first = images[0];
const prepared = await Promise.all(
  images.map(async (image) => ({
    ...image,
    attributes: await imageAttributes(image.src, image.width, image.height),
  })),
);
const initial = prepared[0];
---

<section
  aria-label="Galería del perfume"
  data-gallery
  class="min-w-0 space-y-space-md"
>
  {first ? (
    <>
      <img
        data-gallery-main
        {...initial!.attributes}
        sizes={
          initial!.attributes.srcset
            ? '(min-width: 1024px) 45vw, 90vw'
            : undefined
        }
        alt={first.alt}
        loading="eager"
        fetchpriority="high"
        class="aspect-[4/5] max-h-[42rem] w-full bg-surface-container object-contain"
      />
      {images.length > 1 && (
        <nav
          aria-label="Imágenes del perfume"
          class="flex gap-space-sm overflow-x-auto"
        >
          {prepared.map((image, i) => (
            <a
              class="block min-w-20 border border-outline-variant p-space-xs focus-visible:outline-primary"
              href={image.src}
              data-gallery-choice
              data-alt={image.alt}
              data-main-src={image.attributes.src}
              data-main-srcset={image.attributes.srcset}
              data-main-width={image.attributes.width}
              data-main-height={image.attributes.height}
              aria-label={`Ver imagen ${i + 1}`}
              aria-current={i === 0 ? 'true' : undefined}
            >
              <CatalogImageElement
                src={image.src}
                alt=""
                maxWidth={160}
                sizes="80px"
                loading="lazy"
                class="h-24 w-20 object-cover"
              />
            </a>
          ))}
        </nav>
      )}
      <p class="type-caption" data-gallery-caption>
        {first.alt}
      </p>
    </>
  ) : (
    <p class="flex aspect-[4/5] items-center justify-center bg-surface-container p-space-lg">
      Imagen no disponible
    </p>
  )}
</section>
<script>
  document
    .querySelectorAll<HTMLElement>('[data-gallery]')
    .forEach((gallery) => {
      const main = gallery.querySelector<HTMLImageElement>(
        '[data-gallery-main]',
      );
      const choices = gallery.querySelectorAll<HTMLAnchorElement>(
        '[data-gallery-choice]',
      );
      choices.forEach((choice) =>
        choice.addEventListener('click', (event) => {
          if (
            !main ||
            event.ctrlKey ||
            event.metaKey ||
            event.shiftKey ||
            event.altKey
          )
            return;
          event.preventDefault();
          main.src = choice.dataset.mainSrc ?? choice.href;
          if (choice.dataset.mainSrcset)
            main.srcset = choice.dataset.mainSrcset;
          else main.removeAttribute('srcset');
          if (choice.dataset.mainWidth)
            main.width = Number(choice.dataset.mainWidth);
          if (choice.dataset.mainHeight)
            main.height = Number(choice.dataset.mainHeight);
          main.alt = choice.dataset.alt ?? '';
          const caption = gallery.querySelector('[data-gallery-caption]');
          if (caption) caption.textContent = main.alt;
          choices.forEach((other) => other.removeAttribute('aria-current'));
          choice.setAttribute('aria-current', 'true');
        }),
      );
    });
</script>
