---
import { imageAttributes } from '../../lib/images';
interface Props {
  src: string;
  alt: string;
  class?: string;
  width?: number | null;
  height?: number | null;
  maxWidth?: number;
  sizes?: string;
  loading?: 'eager' | 'lazy';
}
const {
  src,
  alt,
  class: className,
  width,
  height,
  maxWidth = 640,
  sizes = '(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 90vw',
  loading = 'lazy',
} = Astro.props;
const attributes = await imageAttributes(src, width, height, maxWidth);
---

<img
  {...attributes}
  alt={alt}
  sizes={attributes.srcset ? sizes : undefined}
  loading={loading}
  decoding="async"
  class={className}
/>
