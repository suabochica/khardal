---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/atoms/Button.astro';
import Link from '../../components/atoms/Link.astro';
import Icon from '../../components/atoms/Icon.astro';
import Badge from '../../components/atoms/Badge.astro';
import Chip from '../../components/atoms/Chip.astro';
import TextField from '../../components/atoms/TextField.astro';
import Choice from '../../components/atoms/Choice.astro';
import Status from '../../components/atoms/Status.astro';
import ProductCard from '../../components/molecules/ProductCard.astro';
import Breadcrumbs from '../../components/molecules/Breadcrumbs.astro';
import QuantityControl from '../../components/molecules/QuantityControl.astro';
import VariantSelector from '../../components/molecules/VariantSelector.astro';

if (!import.meta.env.DEV) return new Response(null, { status: 404 });

const swatches = [
  ['surface', 'bg-surface', '#fcf9f6'],
  ['surface-container', 'bg-surface-container', '#f1edea'],
  ['primary', 'bg-primary text-on-primary', '#844e34'],
  ['secondary', 'bg-secondary text-on-secondary', '#755843'],
  ['on-surface', 'bg-on-surface text-surface', '#1c1c1a'],
  ['error', 'bg-error text-on-error', '#ba1a1a'],
];
---

<BaseLayout
  title="Sistema de diseño | Khardal Perfumería"
  description="Vista de desarrollo del sistema visual de Khardal Perfumería."
>
  <main id="contenido" class="page-container section-space space-y-space-xl">
    <header class="max-w-3xl space-y-space-md">
      <p class="type-label text-primary">Khardal · Sistema de diseño</p>
      <h1 class="type-display">Calma, carácter y una esencia propia.</h1>
      <p>
        Vista de desarrollo. Todos los ejemplos de productos y estados son
        demostraciones, no un catálogo de venta.
      </p>
    </header>
    <section aria-labelledby="palette-heading" class="space-y-space-md">
      <h2 id="palette-heading" class="type-headline">
        01 / Paleta
      </h2>
      <div class="grid grid-cols-2 gap-gutter md:grid-cols-3">
        {swatches.map(([name, color, hex]) => (
          <div
            class:list={[
              'min-h-36 border border-outline-variant p-space-md',
              color,
            ]}
          >
            <p class="type-label">{name}</p>
            <p>{hex}</p>
          </div>
        ))}
      </div>
    </section>
    <section aria-labelledby="type-heading" class="space-y-space-md">
      <h2 id="type-heading" class="type-headline">
        02 / Tipografía
      </h2>
      <p class="type-display">Notas que dejan huella</p>
      <p class="type-title">Metrophobic · Títulos con aire y carácter</p>
      <p class="max-w-prose">
        Inter · Una lectura serena en cada pantalla. Bogotá, perfumería, ámbar y
        corazón: caracteres del español con fuentes alojadas en nuestro sitio.
      </p>
      <p class="type-caption">Texto secundario legible · 14 px</p>
      <a
        class="inline-flex min-h-11 items-center text-primary underline"
        href="#palette-heading"
      >
        Revisar la paleta
      </a>
    </section>
    <section aria-labelledby="atoms-heading" class="space-y-space-lg">
      <h2 id="atoms-heading" class="type-headline">
        03 / Acciones y formularios
      </h2>
      <div class="flex flex-wrap items-center gap-space-md">
        <Button data-demo-action>
          Confirmar ejemplo <Icon name="arrow" />
        </Button>
        <Button variant="secondary" data-demo-action>
          Acción secundaria
        </Button>
        <Link href="#type-heading">Volver a tipografía</Link>
        <Button disabled>No disponible</Button>
        <Button loading>Guardar</Button>
      </div>
      <p id="demo-action-status" role="status" class="type-caption">
        Las acciones de esta sección son demostraciones.
      </p>
      <div class="flex flex-wrap gap-space-sm">
        <Badge>Ejemplo</Badge>
        <Badge variant="accent">Destacado</Badge>
        <Badge variant="error">Agotado</Badge>
      </div>
      <div class="flex flex-wrap gap-space-sm">
        <Chip>Amaderado</Chip>
        <Chip selected>Ámbar</Chip>
        <Chip disabled>Sin datos</Chip>
      </div>
      <div class="grid gap-space-lg md:grid-cols-2">
        <TextField
          id="demo-email"
          name="email"
          type="email"
          label="Correo electrónico"
          hint="Ejemplo de campo requerido; no enviamos datos."
          placeholder="tu@correo.com"
          required
          autocomplete="email"
        />
        <TextField
          id="demo-error"
          label="Nombre"
          value=""
          error="Escribe tu nombre para continuar."
        />
        <TextField
          id="demo-disabled"
          label="Campo deshabilitado"
          disabled
          value="Solo demostración"
        />
        <fieldset>
          <legend class="font-medium">Presentación de ejemplo</legend>
          <div class="flex flex-wrap gap-space-md">
            <Choice
              id="demo-radio-30"
              type="radio"
              name="demo-size"
              value="30"
              label="30 ml"
              checked
            />
            <Choice
              id="demo-radio-60"
              type="radio"
              name="demo-size"
              value="60"
              label="60 ml"
            />
          </div>
        </fieldset>
      </div>
      <Choice id="demo-checkbox" label="Activar opción de ejemplo" />
      <Status>Cargando información de ejemplo…</Status>
      <Status variant="error">
        No pudimos cargar el ejemplo. Intenta de nuevo.
      </Status>
    </section>
    <section
      id="product-controls"
      aria-labelledby="products-heading"
      class="space-y-space-lg"
    >
      <h2 id="products-heading" class="type-headline">
        04 / Componentes de producto
      </h2>
      <Breadcrumbs
        items={[
          { label: 'Inicio', href: '/' },
          { label: 'Sistema de diseño', href: '/dev/design' },
          { label: 'Productos de ejemplo' },
        ]}
      />
      <p class="type-caption">
        Precios y nombres ficticios para revisar la interfaz. Las fotografías
        son referencias, no productos aprobados.
      </p>
      <div class="grid grid-cols-1 gap-gutter min-[380px]:grid-cols-2 lg:grid-cols-3">
        <ProductCard
          name="Muestra editorial de ámbar y maderas con un nombre extraordinariamente largo"
          href="#product-controls"
          amountCop={38300}
          from
          notes="Notas de ejemplo · Ámbar, madera y especias"
          image={{
            src: '/images/01-product.png',
            alt: 'Referencia de un frasco sobre lino; no representa un producto aprobado.',
          }}
        />
        <ProductCard
          name="Muestra sin disponibilidad"
          href="#product-controls"
          amountCop={67600}
          available={false}
          image={{
            src: '/images/02-product.png',
            alt: 'Referencia de frasco junto a higos y madera.',
          }}
        />
        <ProductCard
          name="Muestra sin fotografía ni notas"
          href="#product-controls"
          amountCop={0}
        />
      </div>
      <div class="grid gap-space-xl md:grid-cols-2">
        <VariantSelector
          id="demo-variants"
          variants={[
            { id: '30', label: '30 ml', amountCop: 38300, available: true },
            { id: '60', label: '60 ml', amountCop: 46300, available: true },
            {
              id: '100',
              label: '100 ml · Presentación de ejemplo agotada',
              amountCop: 67600,
              available: false,
            },
          ]}
        />
        <div class="space-y-space-lg">
          <QuantityControl id="demo-quantity" max={5} />
          <VariantSelector
            id="demo-sold-out"
            legend="Sin disponibilidad"
            variants={[
              {
                id: '100',
                label: '100 ml',
                amountCop: 67600,
                available: false,
              },
            ]}
          />
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  document
    .querySelectorAll<HTMLButtonElement>('[data-demo-action]')
    .forEach((button) => {
      button.addEventListener('click', () => {
        const status = document.getElementById('demo-action-status');
        if (status)
          status.textContent =
            'Acción de ejemplo completada. No se enviaron datos.';
      });
    });
</script>
