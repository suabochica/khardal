---
import StoreLayout from '../layouts/StoreLayout.astro';
import CatalogCard from '../components/commerce/CatalogCard.astro';
import CatalogError from '../components/commerce/CatalogError.astro';
import Accordion from '../components/molecules/Accordion.astro';
import { getCommerce } from '../lib/commerce/provider.server';
let catalog;
try {
  const commerce = await getCommerce();
  catalog = {
    provider: commerce.provider,
    collections: await commerce.listCollections(),
    products: await commerce.listProducts({
      collection: 'top-10',
      pageSize: 3,
    }),
  };
} catch {
  Astro.response.status = 503;
}
Astro.response.headers.set('Cache-Control', 'no-store');
---

<StoreLayout
  title="Khardal Perfumería | Encuentra tu próximo perfume"
  description="Explora fragancias y conoce cómo solicitar tu pedido con el equipo de Khardal Perfumería por WhatsApp en Colombia."
  sample={catalog?.provider === 'mock'}
>
  {catalog ? (
    <>
      <section class="page-container section-space grid items-center gap-space-xl lg:grid-cols-2">
        <div class="space-y-space-lg">
          <p class="type-label text-primary">Khardal Perfumería · Colombia</p>
          <h1 class="type-display">
            Un aroma.
            <br />
            Tu propia historia.
          </h1>
          <p class="max-w-lg text-on-surface-variant">
            Explora matices frescos, florales y amaderados. Encuentra una
            fragancia que te acompañe a tu manera.
          </p>
          <a class="action action-primary" href="/tienda">
            Explorar perfumes
          </a>
          <p class="type-caption">
            Atención por WhatsApp. Disponibilidad, envío y pago se confirman con
            nuestro equipo.
          </p>
        </div>
        <figure class="bg-surface-container p-space-md">
          <img
            src="/images/demo-bottle.svg"
            alt="Ilustración de muestra de un frasco sobre una superficie cálida"
            width="600"
            height="750"
            fetchpriority="high"
            class="max-h-[36rem] w-full object-cover"
          />
          <figcaption class="type-caption pt-space-sm">
            Una mirada al universo Khardal · Ilustración de desarrollo
          </figcaption>
        </figure>
      </section>
      <section class="bg-surface-container-low">
        <div class="page-container section-space grid gap-space-xl md:grid-cols-3">
          <article>
            <p class="type-label text-primary">01 / Explora</p>
            <h2 class="type-title my-space-sm">Encuentra tu presentación</h2>
            <p>Compara tamaños y precios antes de elegir.</p>
          </article>
          <article>
            <p class="type-label text-primary">02 / Conversa</p>
            <h2 class="type-title my-space-sm">Atención por WhatsApp</h2>
            <p>Consulta tus dudas directamente con nuestro equipo.</p>
          </article>
          <article>
            <p class="type-label text-primary">03 / Confirma</p>
            <h2 class="type-title my-space-sm">Los detalles, contigo</h2>
            <p>
              La disponibilidad, el envío y el pago se acuerdan antes de
              confirmar el pedido. Explorar no reserva inventario.
            </p>
          </article>
        </div>
      </section>
      <section
        id="seleccion"
        class="page-container section-space space-y-space-xl"
      >
        <div>
          <p class="type-label text-primary">Para empezar a descubrir</p>
          <h2 class="type-headline mt-space-sm">Una selección con carácter</h2>
          <p class="mt-space-sm type-caption">
            Selección curada de muestra. No representa un ranking de ventas.
          </p>
        </div>
        <div class="grid grid-cols-1 gap-gutter sm:grid-cols-2 lg:grid-cols-3">
          {catalog.products.items.map((product) => (
            <CatalogCard product={product} />
          ))}
        </div>
        <nav aria-label="Colecciones" class="flex flex-wrap gap-space-md">
          {catalog.collections
            .filter((c) => c.slug !== 'top-10')
            .map((c) => (
              <a
                class="action action-secondary"
                href={`/colecciones/${c.slug}`}
              >
                {c.name}
              </a>
            ))}
        </nav>
        <div class="grid gap-space-lg md:grid-cols-2">
          {catalog.collections
            .filter((c) => c.slug !== 'top-10')
            .map((c) => (
              <article
                id={`coleccion-${c.slug}`}
                class="bg-surface-container p-space-xl"
              >
                <h3 class="type-title">{c.name}</h3>
                <p class="mt-space-sm">{c.description}</p>
              </article>
            ))}
        </div>
      </section>
      <section class="bg-surface-container-low">
        <div class="page-container section-space grid gap-space-xl lg:grid-cols-2">
          <div class="space-y-space-lg">
            <p class="type-label text-primary">Conoce Khardal</p>
            <h2 class="type-headline">El gusto por descubrir</h2>
            <p>
              Khardal Perfumería es una tienda de perfumes en Colombia. Te
              acompañamos a explorar opciones y resolver tus dudas por WhatsApp.
            </p>
            <a class="action action-text" href="https://wa.me/573108570230">
              Conversemos sobre perfumes
            </a>
            <a class="action action-text" href="/nosotros">
              Conoce Khardal
            </a>
          </div>
          <div id="preguntas">
            <h2 class="type-headline mb-space-lg">Antes de elegir</h2>
            <Accordion title="¿Cómo se confirma un pedido?">
              <p>
                Una solicitud por WhatsApp inicia la conversación. Nuestro
                equipo confirma disponibilidad, envío, valor final y forma de
                pago. Abrir WhatsApp no confirma una compra.
              </p>
            </Accordion>
            <Accordion title="¿Cuánto cuesta el envío?">
              <p>
                El envío está por confirmar con el equipo según el destino. No
                se incluye un costo estimado en esta demostración.
              </p>
            </Accordion>
            <Accordion title="¿Puedo pedir orientación?">
              <p>
                Sí. Escríbenos al +57 310 8570230 y cuéntanos qué tipo de
                fragancia buscas.
              </p>
            </Accordion>
          </div>
        </div>
      </section>
    </>
  ) : (
    <CatalogError />
  )}
</StoreLayout>
