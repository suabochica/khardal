---
import { DEPLOYMENT_ENV } from 'astro:env/server';
import '../styles/global.css';
import headingFont from '@fontsource/metrophobic/files/metrophobic-latin-400-normal.woff2?url';
import bodyFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import { pageSeo, siteOrigin, jsonLd } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown>[];
}

const {
  title,
  description,
  noindex = false,
  structuredData = [],
} = Astro.props;
const site = siteOrigin(import.meta.env.SITE);
const seo = pageSeo(Astro.url, site, DEPLOYMENT_ENV, noindex);
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="preload"
      href={headingFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={bodyFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="description" content={description} />
    {!seo.indexable && <meta name="robots" content="noindex, nofollow" />}
    {seo.canonical && <link rel="canonical" href={seo.canonical} />}
    <meta property="og:site_name" content="Khardal Perfumería" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {seo.canonical && <meta property="og:url" content={seo.canonical} />}
    {site && (
      <>
        <meta
          property="og:image"
          content={new URL('/social-preview.png', site).href}
        />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="Khardal Perfumería · Colombia" />
      </>
    )}
    <meta
      name="twitter:card"
      content={site ? 'summary_large_image' : 'summary'}
    />
    {structuredData.map((data) => (
      <script type="application/ld+json" set:html={jsonLd(data)} />
    ))}
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
